// Firestore security rules for Math Arcade. Paste this whole file into
// Firebase console > Firestore Database > Rules, then press Publish.
// The UID in isTeacher below is the teacher account's User UID. It must
// match teacherUid in js/config.js.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isTeacher() {
      return request.auth != null
        && request.auth.uid == "c7XsczYvZOghPpQEfeyblMnro2T2";
    }

    // A real student: signed in as this account, and the teacher has
    // created their record. Self-made accounts fail this check.
    function isStudent(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && exists(/databases/$(database)/documents/students/$(uid));
    }

    // Lets the dashboard read every student's summary in one query.
    match /{path=**}/summary/{doc} {
      allow read: if isTeacher();
    }

    match /students/{uid} {
      // Only the teacher creates, edits or removes students.
      allow read: if isTeacher() || (request.auth != null && request.auth.uid == uid);
      allow write: if isTeacher();

      // One entry per answered question. Students can add, never change.
      match /attempts/{attemptId} {
        allow read: if isTeacher();
        allow create: if isStudent(uid)
          && request.resource.data.keys().hasOnly(
            ["answer", "at", "correct", "game", "given", "prompt"])
          && request.resource.data.at == request.time
          && request.resource.data.correct is bool
          && request.resource.data.given is string
          && request.resource.data.given.size() <= 40
          && request.resource.data.prompt is string
          && request.resource.data.prompt.size() <= 200;
      }

      // Running totals for the dashboard. Students update their own.
      match /summary/{doc} {
        allow read: if isTeacher() || isStudent(uid);
        allow create, update: if isStudent(uid)
          && doc == "all"
          && request.resource.data.keys().hasOnly(
            ["games", "lastPlayed", "questions", "right", "wrong"]);
      }
    }
  }
}
